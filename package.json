{
    "name": "@system76/satteri-relative-markdown-links",
    "type": "module",
    "version": "1.0.1",
    "license": "GPL-3.0-only",
    "description": "Rewrite relative markdown links to site page paths, as a satteri mdast plugin.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/system76/satteri-relative-markdown-links.git"
    },
    "homepage": "https://github.com/system76/satteri-relative-markdown-links",
    "bugs": {
        "url": "https://github.com/system76/satteri-relative-markdown-links/issues"
    },
    "keywords": [
        "satteri",
        "mdast",
        "markdown",
        "mdx",
        "astro",
        "relative-links",
        "plugin"
    ],
    "author": {
        "name": "Erin O'Connell",
        "email": "erin@system76.com",
        "url": "https://github.com/system76"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "warn"
        }
    },
    "scripts": {
        "prepack": "tsc",
        "build": "tsc",
        "pretest": "tsc",
        "test": "node --test",
        "test:coverage": "node --test --experimental-test-coverage",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "peerDependencies": {
        "satteri": "^0.9.0"
    },
    "dependencies": {
        "github-slugger": "^2.0.0",
        "smol-toml": "^1.7.0",
        "yaml": "^2.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/mdast": "^4.0.4",
        "@types/node": "^24.13.2",
        "prettier": "^3.9.4",
        "prettier-plugin-organize-imports": "^4.3.0",
        "satteri": "^0.9.4",
        "typescript": "^6.0.3"
    },
    "packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8"
}
