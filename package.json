{
    "name": "@system76/satteri-relative-markdown-links",
    "type": "module",
    "version": "1.1.0",
    "license": "MIT",
    "description": "Rewrite relative markdown links to site page paths, as a satteri mdast plugin.",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/system76/satteri-relative-markdown-links.git"
    },
    "homepage": "https://github.com/system76/satteri-relative-markdown-links",
    "bugs": {
        "url": "https://github.com/system76/satteri-relative-markdown-links/issues"
    },
    "keywords": [
        "satteri",
        "mdast",
        "markdown",
        "mdx",
        "astro",
        "relative-links",
        "plugin",
        "satteri-plugin",
        "astro-integration",
        "withastro",
        "tooling"
    ],
    "author": {
        "name": "Erin O'Connell",
        "email": "erin@system76.com",
        "url": "https://github.com/system76"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "src"
    ],
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": ">=24",
            "onFail": "warn"
        }
    },
    "scripts": {
        "prepack": "tsc",
        "build": "tsc",
        "pretest": "tsc",
        "test": "node --test",
        "test:coverage": "node --test --experimental-test-coverage",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "peerDependencies": {
        "satteri": "^0.9.0"
    },
    "dependencies": {
        "github-slugger": "^2.0.0",
        "smol-toml": "^1.7.0",
        "yaml": "^2.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/mdast": "^4.0.4",
        "@types/node": "^24.13.3",
        "prettier": "^3.9.5",
        "prettier-plugin-organize-imports": "^4.3.0",
        "satteri": "^0.9.5",
        "typescript": "^6.0.3"
    },
    "packageManager": "pnpm@11.13.0+sha512.88d94724d8f2e6c186744a5584c6e59ecac869ec7ba15e9cb4cd628e8dc7066820b2481d8ee3b51ea8da323a7378068aa58c556a3720d32b7c20a051d088363a"
}
